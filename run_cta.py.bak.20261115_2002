# ── Chinese futures market trading period (day/night) ──
DAY_START = dtime(8, 45)
DAY_END = dtime(15, 1)

NIGHT_START = dtime(20, 45)
NIGHT_END = dtime(23, 5)  # 夜盘当日收盘（豆粕/白糖/螺纹/PTA/PVC 等 23:00 收）

# 夜盘是否跨零点：跑到 01:00 收（有色）或 02:30 收（原油/贵金属）的品种时改 True
NIGHT_CROSS_MIDNIGHT = False
MIDNIGHT_END = dtime(2, 45)  # 跨零点夜盘延续截止（NIGHT_CROSS_MIDNIGHT=True 时生效）


def check_trading_period() -> bool:
    """检查当前是否在交易时段内（周六周日不交易；凌晨归前一交易日）"""
    now = datetime.now()
    weekday = now.weekday()
    t = now.time()

    if NIGHT_CROSS_MIDNIGHT:
        # 凌晨为前一交易日夜盘延续，只有周二~周六凌晨才有（周一凌晨、周日无盘）
        if t <= MIDNIGHT_END:
            return 1 <= weekday <= 5
        if weekday >= 5:
            return False
        return (DAY_START <= t <= DAY_END) or (t >= NIGHT_START)

    # 夜盘不跨零点：周六周日全天不跑
    if weekday >= 5:
        return False
    return (DAY_START <= t <= DAY_END) or (NIGHT_START <= t <= NIGHT_END)


def _load_secrets() -> dict:
    """读 secrets.yaml（simnow 凭证 / 飞书 webhook），按 cwd → 源码 → home 顺序查找"""
    paths = [
        Path.cwd() / ".vntrader" / "secrets.yaml",
        Path(__file__).resolve().parent / ".vntrader" / "secrets.yaml",
        Path.home() / ".vntrader" / "secrets.yaml",
    ]
    for p in paths:
        if p.exists():
            try:
                with open(p, encoding="utf-8") as f:
                    return yaml.safe_load(f) or {}
            except Exception:
                pass
    return {}


def load_ctp_setting() -> dict:
    """加载 CTP 配置：simnow 凭证读 secrets.yaml，实盘全走环境变量（不落盘）"""
    mode = os.getenv("CTP_MODE", "real")

    if mode == "simnow":
        # simnow 凭证写在账户目录 .vntrader/secrets.yaml（虚拟资金，不敏感）
        secrets = _load_secrets()
        username = secrets.get("simnow_user", "")
        password = secrets.get("simnow_password", "")
        if not username or not password:
            return {}
        return {
            "用户名": username,
            "密码": password,
            "经纪商代码": "9999",
            "交易服务器": "182.254.243.31:30003",
            "行情服务器": "182.254.243.31:30013",
            "产品名称": "simnow_client_test",
            "授权编码": "0000000000000000",
            "产品信息": "",
        }

    # 实盘：凭证与服务器信息全走环境变量，代码里不留真实信息
    username = os.getenv("CTP_USER")
    password = os.getenv("CTP_PASSWORD")
    if not username or not password:
        return {}
    return {
        "用户名": username,
        "密码": password,
        "经纪商代码": os.getenv("CTP_BROKER", ""),
        "交易服务器": os.getenv("CTP_TD_SERVER", ""),
        "行情服务器": os.getenv("CTP_MD_SERVER", ""),
        "产品名称": os.getenv("CTP_APPID", ""),
        "授权编码": os.getenv("CTP_AUTHCODE", ""),
        "产品信息": "",
    }


def _rollover_alert(text: str) -> None:
    """换月表相关的失败提醒：优先走 notify，失败就只记日志，绝不影响交易。"""
    logger.error(text.replace("\n", " "))
    try:
        notify.send_text(text)
    except Exception as exc:                      # noqa: BLE001
        logger.error(f"换月表提醒发送失败：{exc}")


def _rollover_watchdog() -> None:
    """每个交易日 17:30 之后：先快速确认主力有没有变，真的变了才跑全量更新。

    跑在守护线程里，不碰交易线程；收盘后阻塞也无所谓。
    判定链：rollover_check.py（~1 分钟）→ rc==10 才跑 rollover_daily.py（~8 分钟）。
    """
    repo = Path(__file__).resolve().parent
    py = sys.executable
    check = repo / "scripts" / "rollover_check.py"
    daily = repo / "scripts" / "rollover_daily.py"
    if not check.exists() or not daily.exists():
        logger.warning("换月表守护：scripts 下缺 rollover_check.py / rollover_daily.py，跳过")
        return

    run_at = (17, 30)
    done_day = None
    while True:
        try:
            now = datetime.now()
            if (now.weekday() < 5
                    and (now.hour, now.minute) >= run_at
                    and done_day != now.date()):
                done_day = now.date()
                logger.info("换月表：开始收盘后检查主力变化")
                rc = subprocess.call([py, str(check)], cwd=str(repo))
                if rc == 0:
                    logger.info("换月表：主力无变化，无需更新")
                elif rc == 10:
                    logger.info("换月表：检测到换月，开始全量更新（收盘后阻塞无所谓）")
                    started = time_mod.time()
                    rc2 = subprocess.call([py, str(daily)], cwd=str(repo))
                    logger.info(
                        f"换月表：全量更新结束 rc={rc2}，"
                        f"用时 {time_mod.time() - started:.0f}s"
                    )
                    if rc2 != 0:
                        # 兜底：万一 rollover_daily.py 自己没发出去（崩溃/没配 webhook）
                        _rollover_alert(
                            f"🚨 换月复权表更新失败（退出码 {rc2}）\n"
                            f"  交易品种的复权因子可能已过期\n"
                            f"  日志：{repo / 'scripts' / 'logs'}"
                        )
                else:
                    logger.warning(f"换月表：检查失败 rc={rc}，本次不更新")
                    _rollover_alert(
                        f"⚠️ 换月表检查失败（退出码 {rc}）\n"
                        f"  本次未能确认主力是否变化\n"
                        f"  日志：{repo / 'scripts' / 'logs'}"
                    )
        except Exception as exc:                      # noqa: BLE001
            logger.error(f"换月表守护线程异常：{exc}")
        sleep(60)


def run_child(child_conn=None) -> None:
    """子进程：运行 vnpy 全栈"""
    SETTINGS["log.file"] = True

    ctp_setting = load_ctp_setting()
    if not ctp_setting:
        logger.error("CTP 配置加载失败，子进程退出")
        sys.exit(1)

    notify = NotificationManager(feishu_webhook=os.getenv("FEISHU_WEBHOOK", ""))
    notify.set_log_callback(lambda msg: logger.info(f"[Notify] {msg}"))

    event_engine: EventEngine = EventEngine()
    main_engine: MainEngine = MainEngine(event_engine)
    main_engine.add_gateway(CtpGateway)
    cta_engine = RolloverCtaEngine(main_engine, event_engine)
    main_engine.engines[cta_engine.engine_name] = cta_engine
    logger.info(f"主引擎创建成功（{type(cta_engine).__name__}）")

    log_engine = main_engine.get_engine("log")
    event_engine.register(EVENT_CTA_LOG, log_engine.process_log_event)
    logger.info("注册日志事件监听")

    main_engine.connect(ctp_setting, "CTP")
    logger.info("连接CTP接口")

    logger.info("等待CTP连接和数据加载...")
    sleep(40)

    # 修复 vnpy 空/损坏 JSON 文件导致崩溃的 bug（size==0 或 json 解析失败都重置）
    for filename in ("cta_strategy_setting.json", "cta_strategy_data.json"):
        p = get_file_path(filename)
        if not p.exists():
            continue
        try:
            with open(p, encoding="utf-8") as f:
                json.load(f)
        except Exception:
            p.write_text("{}")
            logger.info(f"已修复损坏的 JSON 文件: {filename}")

    cta_engine.init_engine()
    logger.info("CTA引擎初始化完成（策略已自动加载）")

    cta_engine.init_all_strategies()

    # 用交易所日线校验/补齐上一交易日结算价：后台线程，网络失败不影响开盘
    threading.Thread(
        target=cta_engine.sync_settlements_from_api, daemon=True
    ).start()

    # 保证金率：openctp 合约字典，后台线程；失败沿用 8% 兜底
    threading.Thread(
        target=cta_engine.sync_margin_rates, daemon=True
    ).start()

    sleep(60)
    logger.info("CTA策略全部初始化")

    cta_engine.send_rollover_init_summary()
    cta_engine.start_all_strategies()
    logger.info("CTA策略全部启动")

    # 收盘后自动检查/更新换月表（守护线程，不阻塞交易）
    threading.Thread(target=_rollover_watchdog, daemon=True,
                     name="rollover-watchdog").start()
    logger.info("换月表守护线程已启动（每交易日 17:30 后检查主力变化）")

    sleep(60)
    notify.send_startup_notification()

    try:
        # 启动后发一次账户报告（含系统状态）
        sleep(5)
        notify.send_account_report(
            main_engine, order_stats=cta_engine.get_daily_order_stats()
        )

        last_report_time = time_mod.time()
        REPORT_INTERVAL = 420  # 7分钟

        while True:
            sleep(1)

            # 检查父进程停止指令（正常退出：撤挂单 + 写持仓）
            if child_conn is not None and child_conn.poll():
                msg = child_conn.recv()
                if msg == "stop":
                    logger.info("收到父进程停止指令，正常退出")
                    break

            trading = check_trading_period()
            if not trading:
                logger.info("非交易时段，关闭子进程")
                break

            # 事件线程看门狗：CTP 账户事件每 ~4 秒刷新 last_activity_time。
            # vnpy 的 EventEngine._run 只 catch Empty，任何 handler 抛异常都会让
            # 事件线程静默退出；这里 300 秒不动就应急停策略（会撤单）并退出，
            # 由父进程重新拉起。
            if time_mod.time() - cta_engine.last_activity_time > 300:
                logger.error("300 秒无任何 CTP 事件（事件线程可能已停止），应急退出")
                notify.send_text("🚨 事件线程疑似停止，子进程应急退出等待重启")
                try:
                    cta_engine.stop_all_strategies()
                except Exception as exc:
                    logger.error(f"应急停止策略失败：{exc}")
                notify.close(3)
                os._exit(2)

            if time_mod.time() - last_report_time >= REPORT_INTERVAL:
                notify.send_account_report(
                    main_engine, order_stats=cta_engine.get_daily_order_stats()
                )
                last_report_time = time_mod.time()

    except KeyboardInterrupt:
        logger.info("收到中断信号")

    logger.info("发送当日盈亏汇总...")
    cta_engine.send_daily_pl_summary()

    # 每次退出都落库并归零累计盈亏：同一交易日的多段（夜盘 23:05 + 次日日盘
    # 15:01）会累加到 daily_pnl 的同一行，不会拆成两行；盘中手动停止也会写当天
    # 那一行并归零，不会串到下一个交易日。
    logger.info("落库并归零累计盈亏...")
    cta_engine.reset_daily_pl()

    # 只在日盘收盘后（15:00 后、夜盘开盘前）标记挂单失效；
    # 夜盘是次日交易日的开始，夜盘挂单保留到次日日盘 15:00 收盘才失效
    now = datetime.now().time()
    if DAY_END <= now < NIGHT_START:
        logger.info("标记未成交挂单失效...")
        cta_engine._mark_stale_orders()

    logger.info("停止所有策略...")
    cta_engine.stop_all_strategies()
    # 通知已改为异步队列：退出前先把引擎那条（日报/成交）和子进程这条都发完
    cta_engine.notify.close()
    notify.send_shutdown_notification()
    notify.close()

    logger.info("关闭主引擎...")
    main_engine.close()
    logger.info("子进程正常退出")
    sys.exit(0)


def _manual_stop_path() -> Path:
    return get_file_path(".manual_stop")


def _read_manual_stop() -> bool:
    """父进程重启后是否仍保持"手动停止"。"""
    return _manual_stop_path().exists()


def _write_manual_stop(value: bool) -> None:
    try:
        path = _manual_stop_path()
        if value:
            path.write_text(datetime.now().isoformat(), encoding="utf-8")
        elif path.exists():
            path.unlink()
    except Exception as exc:
        print(f"⚠️ 写手动停止标记失败：{exc}", flush=True)


def run_parent() -> None:
    """父进程：按交易时段启停子进程，崩溃自动重启"""
    print("=" * 60)
    print("启动CTA策略守护父进程")
    print("策略配置将由CTA引擎自动加载")
    print("=" * 60, flush=True)

    # 启动时确认 CTP 凭证存在（simnow 读 secrets.yaml，实盘读环境变量）
    mode = os.getenv("CTP_MODE", "real")
    if mode == "simnow":
        secrets = _load_secrets()
        username = secrets.get("simnow_user", "")
        password = secrets.get("simnow_password", "")
        if not username or not password:
            print("❌ 请在 .vntrader/secrets.yaml 填写 simnow_user / simnow_password")
            sys.exit(1)
        print(f"CTP 凭证已就绪 (simnow 用户名: {username})", flush=True)
    else:
        ctp_user = os.getenv("CTP_USER", "")
        ctp_pass = os.getenv("CTP_PASSWORD", "")
        if not ctp_user or not ctp_pass:
            print("❌ 请设置环境变量 CTP_USER 和 CTP_PASSWORD")
            print("   export CTP_USER=your_account")
            print("   export CTP_PASSWORD=your_password", flush=True)
            sys.exit(1)
        print(f"CTP 凭证已就绪 (用户名: {ctp_user})", flush=True)

    # 更新交易时段数据
    print("\n📅 正在更新交易时段数据...")
    run_and_save()
    print("=" * 60)

    # ── 飞书控制（父进程常驻；每个账户一个飞书应用/机器人，各监听自己的端口）──
    # 端口：secrets 里的 feishu_port > 按账户默认（实盘 3000 / 模拟盘 3001）
    ctrl_queue = queue.Queue()
    feishu = load_feishu_control()
    account_label = "模拟盘" if mode == "simnow" else "实盘"
    if feishu.get("app_id"):
        if not feishu.get("verification_token"):
            print(
                "⚠️ 未配置 feishu_verification_token，出于安全不启动飞书控制"
                "（通知不受影响）",
                flush=True,
            )
        else:
            ctrl_port = feishu.get("port") or (3001 if mode == "simnow" else 3000)
            app = build_control_app(
                ctrl_queue,
                feishu["app_id"],
                feishu["app_secret"],
                feishu["encrypt_key"],
                feishu["verification_token"],
                feishu["bot_open_id"],
                account="simnow" if mode == "simnow" else "real",
            )
            threading.Thread(
                target=start_control,
                args=(app, feishu["host"], ctrl_port),
                daemon=True,
            ).start()
            print(
                f"飞书控制已启动（{account_label}）"
                f"app_id={feishu['app_id'][:12]}… "
                f"监听 {feishu['host']}:{ctrl_port}",
                flush=True,
            )
            if feishu.get("public_url"):
                print(
                    f"飞书后台「请求地址」填: {feishu['public_url']}/webhook/feishu",
                    flush=True,
                )

    child_process = None
    parent_conn = None
    restart_count = 0
    max_restart = 5
    # 手动停止落盘：父进程被 systemd 重启后仍保持"已停止"，需 @机器人 重启恢复
    manual_stop = _read_manual_stop()
    if manual_stop:
        print(
            "⏸ 检测到『手动停止』标记：本终端不会自动启动子进程；"
            "@机器人 发『重启』恢复",
            flush=True,
        )
    child_start_time = 0.0  # 子进程启动时间戳（稳定运行过则重置崩溃计数）

    def apply_command(action: str) -> str:
        """执行本账户的 stop / restart，返回给飞书的回复文案。"""
        nonlocal child_process, parent_conn, manual_stop, child_start_time
        if action == "stop":
            manual_stop = True
            _write_manual_stop(True)
            if child_process is not None and child_process.is_alive():
                print(
                    "🛑 飞书指令：停止子进程（正常退出，撤挂单+写持仓）",
                    flush=True,
                )
                if parent_conn is not None:
                    parent_conn.send("stop")
                child_process.join(timeout=30)
                if child_process.is_alive():
                    print("⚠️ 子进程未在30秒内退出，强制终止", flush=True)
                    child_process.terminate()
                    child_process.join(timeout=5)
                    if child_process.is_alive():
                        child_process.kill()
                child_process = None
                return "停止已完成（后续时段不再自动启动，发「重启」恢复）"
            return "当前无运行中的子进程，已置停止状态（发「重启」恢复）"

        manual_stop = False
        _write_manual_stop(False)
        if child_process is not None and child_process.is_alive():
            print("🔄 飞书指令：重启子进程（正常退出旧子进程）", flush=True)
            if parent_conn is not None:
                parent_conn.send("stop")
            child_process.join(timeout=30)
            if child_process.is_alive():
                child_process.terminate()
                child_process.join(timeout=5)
                if child_process.is_alive():
                    child_process.kill()
            child_process = None
        if check_trading_period():
            parent_conn, child_conn = multiprocessing.Pipe()
            child_process = multiprocessing.Process(
                target=run_child, args=(child_conn,)
            )
            child_process.start()
            child_start_time = time_mod.time()
            return f"重启已完成 (PID {child_process.pid})"
        return "重启已完成（非交易时段，子进程未启动）"

    while True:
        try:
            trading = check_trading_period()

            # ── 处理飞书控制指令（do=执行 / say=只回复提示）──
            if feishu.get("app_id"):
                try:
                    cmd = ctrl_queue.get_nowait()
                except queue.Empty:
                    cmd = None
                if cmd is not None:
                    kind, payload, msg_id = cmd
                    reply = payload if kind == "say" else apply_command(payload)
                    reply_text(
                        feishu.get("app_id"),
                        feishu.get("app_secret"),
                        msg_id,
                        reply,
                    )

            if trading and child_process is None and not manual_stop:
                print(f"\n📅 {datetime.now().strftime('%Y-%m-%d %H:%M:%S')}")
                print("🔄 交易时段开始，启动子进程...")
                parent_conn, child_conn = multiprocessing.Pipe()
                child_process = multiprocessing.Process(
                    target=run_child, args=(child_conn,)
                )
                child_process.start()
                print(f"✅ 子进程启动成功 (PID: {child_process.pid})")
                child_start_time = time_mod.time()

            if not trading and child_process is not None:
                if not child_process.is_alive():
                    child_process = None
                    print("✅ 子进程已关闭")
                else:
                    print("⏹ 非交易时段，等待子进程自动关闭...")
                    sleep(10)
                    if child_process and child_process.is_alive():
                        print("⚠️ 子进程未自动退出，强制终止...")
                        child_process.terminate()
                        child_process.join(timeout=5)
                    child_process = None

            if child_process is not None and not child_process.is_alive():
                print("⚠️ 子进程意外退出")
                child_process = None

                if manual_stop:
                    pass  # 手动停止，不自动重启
                elif trading:
                    # 稳定运行过一段时间才重置崩溃计数，否则连续崩溃累加触发熔断
                    if time_mod.time() - child_start_time > 180:
                        restart_count = 0
                    restart_count += 1
                    if restart_count < max_restart:
                        print(f"🔄 尝试重启子进程 ({restart_count}/{max_restart})...")
                        sleep(3)
                    else:
                        print(f"❌ 重启次数过多 ({max_restart})，暂停重启")
                        sleep(60)
                        restart_count = 0

            sleep(1)

        except KeyboardInterrupt:
            print("\n⚠️ 收到中断信号，正在退出...")
            break
        except Exception as e:
            print(f"❌ 父进程异常: {e}")
            sleep(5)

    if child_process is not None and child_process.is_alive():
        print("🔄 正在终止子进程...")
        child_process.terminate()
        child_process.join(timeout=10)
        if child_process.is_alive():
            child_process.kill()
        print("✅ 子进程已终止")

    print("=" * 60)
    print("✅ 程序正常退出")
    print("=" * 60)


if __name__ == "__main__":
    run_parent()
